# ==========================================
# Summit Roofing Co. — Whop Environment Configuration
# ==========================================

# Whop API Credentials (keep server-side only)
WHOP_API_KEY=whop_api_key_xxxxxxxxxxxxxxxxxxxxxxxxxx
WHOP_APP_ID=app_xxxxxxxxxxxxxx
WHOP_COMPANY_ID=biz_xxxxxxxxxxxxxx
WHOP_WEBHOOK_SECRET=whop_whsec_xxxxxxxxxxxxxxxxxxxxxx

# Whop Environment (sandbox or production)
WHOP_ENVIRONMENT=sandbox
WHOP_API_BASE_URL=https://sandbox-api.whop.com/api/v1

# Plan 1: Professional Roof Inspection ($149 USD one-time)
WHOP_PRODUCT_INSPECTION=prod_insp_xxxxxxxxxx
WHOP_PLAN_INSPECTION=plan_insp_xxxxxxxxxx

# Plan 2: Roofing Project Deposit ($500 USD one-time with Setup Intent)
WHOP_PRODUCT_DEPOSIT=prod_dep_xxxxxxxxxx
WHOP_PLAN_DEPOSIT=plan_dep_xxxxxxxxxx

# Plan 3: Standard Roof Maintenance Visit ($299 USD one-time)
WHOP_PRODUCT_MAINTENANCE=prod_maint_xxxxxxxxxx
WHOP_PLAN_MAINTENANCE=plan_maint_xxxxxxxxxx

# Client-Side Exposed Environment Variables (Vite)
VITE_WHOP_COMPANY_ID=biz_xxxxxxxxxxxxxx
VITE_WHOP_APP_ID=app_xxxxxxxxxxxxxx
VITE_WHOP_ENVIRONMENT=sandbox
VITE_WHOP_PRODUCT_INSPECTION=prod_insp_xxxxxxxxxx
VITE_WHOP_PLAN_INSPECTION=plan_insp_xxxxxxxxxx
VITE_WHOP_PRODUCT_DEPOSIT=prod_dep_xxxxxxxxxx
VITE_WHOP_PLAN_DEPOSIT=plan_dep_xxxxxxxxxx
VITE_WHOP_PRODUCT_MAINTENANCE=prod_maint_xxxxxxxxxx
VITE_WHOP_PLAN_MAINTENANCE=plan_maint_xxxxxxxxxx

# Application Public Hosting URL
APP_URL=https://summit-roofing.whop.site
PORT=3000
